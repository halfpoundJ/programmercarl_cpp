{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-debug",
            "description": "Windows only: MinGW makefiles + MSYS2 g++",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build/windows-debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "windows-release",
            "description": "Windows only: MinGW makefiles + MSYS2 g++",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build/windows-release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "macos-debug",
            "description": "macOS only: Unix makefiles + Apple Clang",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/macos-debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-release",
            "description": "macOS only: Unix makefiles + Apple Clang",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/macos-release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}
